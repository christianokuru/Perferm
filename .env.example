# Public site URL — used for canonical URLs, sitemap and Open Graph.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase ---------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# SECRET (server only, bypasses RLS): Project Settings → API Keys → Secret key.
SUPABASE_SECRET_KEY=

# --- Payments ----------------------------------------------------------------
# A gateway goes live only when BOTH its public and secret keys are set.
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=
NEXT_PUBLIC_FLUTTERWAVE_PUBLIC_KEY=
FLUTTERWAVE_SECRET_KEY=
# Any long random string; paste the same value in Flutterwave → Settings → Webhooks.
FLUTTERWAVE_WEBHOOK_HASH=
# Simulated payment screen for gateways without keys. Defaults to on in
# development and OFF in production — never enable it on the live store.
PAYMENTS_DEMO_MODE=

# --- Email (Resend) -----------------------------------------------------------
RESEND_API_KEY=
# Must be on a domain verified in Resend (the default only reaches your own inbox).
EMAIL_FROM="Perferm <onboarding@resend.dev>"
# Where order alerts and concierge messages go (defaults to the support email in settings).
STORE_INBOX_EMAIL=

# --- Auth ----------------------------------------------------------------------
# Show "Continue with Google" once the Google provider is enabled in Supabase.
NEXT_PUBLIC_AUTH_GOOGLE=false

# --- Browser tests (put these in .env.test.local, never here) -----------------
# E2E_ADMIN_EMAIL=
# E2E_ADMIN_PASSWORD=
# E2E_BASE_URL=        # optional: test a deployment instead of the local build
