# Public site URL — used for canonical URLs, sitemap and Open Graph.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Payment gateways (PUBLIC keys only — never put secret keys in NEXT_PUBLIC_ vars).
# Leave empty to use the built-in demo gateway that simulates a payment.
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=
NEXT_PUBLIC_FLUTTERWAVE_PUBLIC_KEY=

# Demo mode only (until Supabase auth is connected): accounts registered with
# these emails get the admin role so the dashboard can be explored.
NEXT_PUBLIC_DEMO_ADMIN_EMAILS=admin@perferm.ng

# ---------------------------------------------------------------------------
# Demo test accounts (throwaway values — NOT real credentials).
# Demo accounts live only in the browser's localStorage where they were
# registered. In a fresh browser, register them once via /register first.
#
#   Customer  ada.test@example.com   Perferm-Test-2026
#   Admin     admin@perferm.ng       Perferm-Admin-2026
#
# Remove this block once Supabase Auth replaces the demo adapter.
# ---------------------------------------------------------------------------
